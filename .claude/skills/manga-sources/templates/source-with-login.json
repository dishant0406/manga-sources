{
  "schema": 1,
  "id": "my-paid-site",
  "name": "My Paid Site",
  "version": 1,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://api.example.com",
  "rate_per_second": 2,
  "page_size": 20,
  "auth": {
    "fields": [
      {
        "id": "email",
        "name": "Email"
      },
      {
        "id": "password",
        "name": "Password",
        "secret": true
      }
    ],
    "login": {
      "request": {
        "method": "POST",
        "url": "{base}/auth/login",
        "json": {
          "email": "{email}",
          "password": "{password}"
        }
      },
      "format": "json",
      "vars": {
        "access": "data.access_token",
        "refresh": "data.refresh_token",
        "user": "data.user.display_name"
      }
    },
    "refresh": {
      "request": {
        "method": "POST",
        "url": "{base}/auth/refresh",
        "json": {
          "refresh_token": "{refresh}"
        }
      },
      "format": "json",
      "vars": {
        "access": "data.access_token",
        "refresh": "data.refresh_token"
      }
    },
    "logout": {
      "method": "POST",
      "url": "{base}/auth/logout",
      "json": {
        "refresh_token": "{refresh}"
      }
    },
    "headers": {
      "authorization": "Bearer {access}"
    }
  },
  "popular": {
    "request": {
      "url": "{base}/series?offset={offset}&per_page=20&sort=popular"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "latest": {
    "request": {
      "url": "{base}/series?offset={offset}&per_page=20&sort=latest"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "search": {
    "request": {
      "url": "{base}/series?offset={offset}&per_page=20{?&search={term}?}{?&genre={genre}?}"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "filters": [
    {
      "id": "genre",
      "name": "Genre",
      "kind": "select",
      "options": [
        {
          "value": "action",
          "name": "Action"
        },
        {
          "value": "romance",
          "name": "Romance"
        }
      ]
    }
  ],
  "detail": {
    "request": {
      "url": "{base}/series/{id}"
    },
    "format": "json",
    "title": "series.title",
    "cover": "series.cover",
    "description": [
      {
        "path": "series.description"
      },
      "plain_text"
    ],
    "authors": "series.author",
    "tags": "series.genres.*.name",
    "status": [
      {
        "path": "series.status"
      },
      {
        "map": [
          [
            "completed",
            "completed"
          ],
          [
            "complete",
            "completed"
          ],
          [
            "finished",
            "completed"
          ],
          [
            "ongoing",
            "ongoing"
          ],
          [
            "publishing",
            "ongoing"
          ],
          [
            "hiatus",
            "hiatus"
          ],
          [
            "on hold",
            "hiatus"
          ],
          [
            "cancelled",
            "cancelled"
          ],
          [
            "canceled",
            "cancelled"
          ],
          [
            "dropped",
            "cancelled"
          ]
        ]
      },
      {
        "default": "unknown"
      }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/series/{id}/chapters?page={page}&per_page=100"
    },
    "format": "json",
    "rows": "data",
    "chapter": {
      "id": "slug",
      "number": "number",
      "title": [
        {
          "path": "number"
        },
        {
          "template": "Chapter {value}"
        }
      ],
      "date": [
        {
          "path": "published_at"
        },
        {
          "date": [
            "iso"
          ]
        }
      ],
      "locked": "is_premium"
    },
    "order": "newest-first",
    "repeat": {
      "size": 100
    }
  },
  "pages": {
    "request": {
      "url": "{base}/series/{series}/chapters/{id}"
    },
    "format": "json",
    "images": "data.pages.*.url",
    "reading": "longstrip"
  }
}
