{
  "schema": 1,
  "id": "my-mangastream-site",
  "name": "My MangaStream Site",
  "version": 1,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://www.example.com",
  "rate_per_second": 2,
  "popular": {
    "request": {
      "url": "{base}/manga/page/{page}/?order=popular"
    },
    "rows": "div.bsx",
    "card": {
      "id": [
        {
          "css": "a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".tt",
      "chapters": ".epxs",
      "cover": [
        {
          "css": "img.ts-post-image"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        },
        "abs"
      ]
    },
    "next": [
      {
        "css": "a.r"
      },
      "text"
    ]
  },
  "latest": {
    "request": {
      "url": "{base}/manga/page/{page}/?order=update"
    },
    "rows": "div.bsx",
    "card": {
      "id": [
        {
          "css": "a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".tt",
      "chapters": ".epxs",
      "cover": [
        {
          "css": "img.ts-post-image"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        },
        "abs"
      ]
    },
    "next": [
      {
        "css": "a.r"
      },
      "text"
    ]
  },
  "search": {
    "request": {
      "url": "{base}/page/{page}/?s={?{term}?}{?&genre={genre}?}"
    },
    "rows": "div.bsx",
    "card": {
      "id": [
        {
          "css": "a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": ".tt",
      "chapters": ".epxs",
      "cover": [
        {
          "css": "img.ts-post-image"
        },
        {
          "attr": "data-src|data-lazy-src|src"
        },
        "abs"
      ]
    },
    "next": "a.next.page-numbers"
  },
  "filters": [
    {
      "id": "genre",
      "name": "Genre",
      "kind": "select",
      "options": [
        {
          "value": "action",
          "name": "Action"
        },
        {
          "value": "fantasy",
          "name": "Fantasy"
        },
        {
          "value": "romance",
          "name": "Romance"
        }
      ]
    }
  ],
  "detail": {
    "request": {
      "url": "{base}/manga/{id}/"
    },
    "title": "h1.entry-title",
    "cover": [
      {
        "css": ".thumb img"
      },
      {
        "attr": "data-src|data-lazy-src|src"
      },
      "abs"
    ],
    "description": ".entry-content-single",
    "tags": ".mgen a",
    "status": [
      {
        "css": ".imptdt i"
      },
      "text",
      {
        "map": [
          [
            "completed",
            "completed"
          ],
          [
            "complete",
            "completed"
          ],
          [
            "finished",
            "completed"
          ],
          [
            "ongoing",
            "ongoing"
          ],
          [
            "publishing",
            "ongoing"
          ],
          [
            "hiatus",
            "hiatus"
          ],
          [
            "on hold",
            "hiatus"
          ],
          [
            "cancelled",
            "cancelled"
          ],
          [
            "canceled",
            "cancelled"
          ],
          [
            "dropped",
            "cancelled"
          ]
        ]
      },
      {
        "default": "unknown"
      }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/manga/{id}/"
    },
    "rows": "#chapterlist li",
    "chapter": {
      "id": [
        {
          "css": "a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/([^/]+)/?$"
        }
      ],
      "title": ".chapternum",
      "date": [
        {
          "css": ".chapterdate"
        },
        "text",
        {
          "date": [
            "MMMM d, yyyy",
            "MMM d, yyyy"
          ]
        }
      ]
    },
    "order": "newest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/{id}/"
    },
    "images": [
      {
        "css": "script"
      },
      "text",
      {
        "regex": "(?s)ts_reader\\.run\\((\\{.*?\\})\\);"
      },
      "json",
      {
        "path": "sources.0.images.*"
      }
    ],
    "reading": "longstrip"
  }
}
