{
  "schema": 1,
  "id": "weebcentral",
  "name": "Weeb Central",
  "version": 1,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://weebcentral.com",
  "rate_per_second": 1,
  "page_size": 32,
  "popular": {
    "request": {
      "url": "{base}/search/data?limit=32&offset={offset}&display_mode=Full%20Display&sort=Popularity&order=Descending&official=Any&anime=Any&adult=Any"
    },
    "rows": "article.bg-base-300",
    "card": {
      "id": [
        {
          "css": "a[href*='/series/']"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/series/([^/]+)/[^/]+$"
        }
      ],
      "title": "a.line-clamp-1",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "src"
        },
        "first"
      ]
    },
    "next": "button[hx-get*='offset=']"
  },
  "latest": {
    "request": {
      "url": "{base}/search/data?limit=32&offset={offset}&display_mode=Full%20Display&sort=Latest%20Updates&order=Descending&official=Any&anime=Any&adult=Any"
    },
    "rows": "article.bg-base-300",
    "card": {
      "id": [
        {
          "css": "a[href*='/series/']"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/series/([^/]+)/[^/]+$"
        }
      ],
      "title": "a.line-clamp-1",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "src"
        },
        "first"
      ]
    },
    "next": "button[hx-get*='offset=']"
  },
  "search": {
    "request": {
      "url": "{base}/search/data?limit=32&offset={offset}&display_mode=Full%20Display&sort=Best%20Match&order=Descending&official=Any&anime=Any&adult=Any{?&text={term}?}{?&author={author}?}{?&included_tag={genre}?}{?&included_type={type}?}{?&included_status={status}?}"
    },
    "rows": "article.bg-base-300",
    "card": {
      "id": [
        {
          "css": "a[href*='/series/']"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/series/([^/]+)/[^/]+$"
        }
      ],
      "title": "a.line-clamp-1",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "src"
        },
        "first"
      ]
    },
    "next": "button[hx-get*='offset=']"
  },
