  "detail": {
    "request": {
      "url": "{base}/series/{id}"
    },
    "title": "h1",
    "cover": [
      {
        "css": "section picture img"
      },
      {
        "attr": "src"
      },
      "first"
    ],
    "description": "p.whitespace-pre-wrap",
    "authors": "a[href*='/search?author=']",
    "tags": "a[href*='/search?included_tag=']",
    "status": "a[href*='/search?included_status=']"
  },
  "chapters": {
    "request": {
      "url": "{base}/series/{id}/full-chapter-list"
    },
    "rows": "#chapter-list > div, div[x-data*='new_chapter']",
    "chapter": {
      "id": [
        {
          "css": "a[href^='/chapters/']"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/chapters/([^/]+)$"
        }
      ],
      "number": "a span.grow > span:first-child",
      "title": "a span.grow > span:first-child",
      "date": [
        {
          "css": "time"
        },
        {
          "attr": "datetime"
        },
        {
          "date": [
            "iso"
          ]
        }
      ]
    },
    "order": "newest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/chapters/{id}/images?reading_style=long_strip&current_page=1"
    },
    "images": [
      {
        "css": "#chapter-images img"
      },
      {
        "attr": "src"
      }
    ],
    "reading": "paged_rtl"
  }
}
