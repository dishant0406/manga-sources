  "settings": [],
  "detail": {
    "request": {
      "url": "{base}/manga/{id}"
    },
    "title": "h1",
    "cover": [
      {
        "css": ".summary_image img"
      },
      {
        "attr": "data-src|src"
      },
      "abs"
    ],
    "description": "#manga-summary",
    "authors": ".author-content a",
    "tags": ".genres-content a",
    "status": [
      {
        "css": ".post-status .post-content_item:nth-of-type(2) .summary-content"
      },
      "text"
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/manga/{id}/chapters?offset={offset}"
    },
    "rows": "li.a-h.item",
    "chapter": {
      "id": [
        {
          "css": "a.chapter-name"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/read/[^/]+/([^/]+/[^/]+)/?$"
        }
      ],
      "number": "@data-number",
      "title": [
        {
          "css": "a.chapter-name"
        },
        {
          "attr": "title"
        }
      ],
      "date": [
        {
          "css": ".chapter-time"
        },
        "text",
        {
          "date": [
            "MMM d, yyyy",
            "relative"
          ]
        }
      ]
    },
    "order": "newest-first",
    "repeat": {
      "size": 100
    }
  },
  "pages": {
    "request": {
      "url": "{base}/read/{series}/{id}"
    },
    "images": [
      {
        "css": ".chapter-reader img.chapter-page-img"
      },
      {
        "attr": "data-src|src"
      }
    ],
    "reading": "paged_rtl"
  }
}
