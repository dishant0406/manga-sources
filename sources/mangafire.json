{
  "schema": 1,
  "id": "mangafire",
  "name": "MangaFire",
  "version": 1,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://mangafire.cc",
  "rate_per_second": 1,
  "page_size": 30,
  "popular": {
    "request": {
      "url": "{base}/top-manga?page={page}"
    },
    "rows": "div.manga-item",
    "card": {
      "id": [
        {
          "css": ".bsx a[href^='/manga/']"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)/?$"
        }
      ],
      "title": "h3",
      "cover": [
        {
          "css": "img"
        },
        {
          "attr": "data-src|src"
        },
        "abs"
      ],
      "chapters": ".chapter"
    },
    "next": "a[rel='next']"
  },
  "latest": {
    "request": {
      "url": "{base}/updated?page={page}"
    },
    "rows": "div.manga-item",
