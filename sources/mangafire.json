        },
        "abs"
      ],
      "chapters": ".chapter"
    },
    "next": "a[rel='next']"
  },
  "search": {
    "request": {
      "url": "{base}/search?page={page}{?&q={term}?}{?&genre%5B%5D={genre}?}{?&status%5B%5D={status}?}{?&sort={sort}?}"
    },
    "rows": "div.manga-item",
    "card": {
