  "detail": {
    "request": {
      "url": "{base}/manga/{id}"
    },
    "title": "#single_book h1.heading",
    "cover": [
      {
        "css": "#single_book .cover img"
      },
      {
        "attr": "src"
      },
      "first"
    ],
    "description": "#single_book .summary p",
    "authors": "#single_book .authors a",
    "tags": "#single_book .meta .genres a",
    "status": "#single_book .status"
  },
  "chapters": {
    "request": {
      "url": "{base}/manga/{id}"
    },
    "rows": "#single_book .chapters table tbody tr",
    "chapter": {
      "id": [
        {
          "css": ".chapter a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/[^/]+/([^/]+)$"
        }
      ],
      "number": ".chapter a",
      "title": ".chapter a",
      "date": [
        {
          "css": ".update_time"
        },
        {
          "date": [
            "MMM-d-yyyy"
          ]
        }
      ]
    },
    "order": "newest-first"
  },
  "pages": {
    "request": {
      "url": "{base}/manga/{series}/{id}"
    },
    "images": [
      {
        "css": "script"
      },
      "text",
      {
        "regex": "(?s)var\\s+thzq\\s*=\\s*(\\[[^\\]]*\\]);function\\s+kxatz"
      },
      {
        "replace": {
          "from": "'",
          "to": "\""
        }
      },
      {
        "replace": {
          "from": ",\\s*\\]",
          "to": "]"
        }
      },
      "json",
      {
        "path": "*"
      }
    ],
    "reading": "paged_rtl",
    "image_headers": {
      "referer": "{base}/"
    }
  }
}
