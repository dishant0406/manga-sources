{
  "schema": 1,
  "id": "mangakatana",
  "name": "MangaKatana",
  "version": 1,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "base_url": "https://mangakatana.com",
  "rate_per_second": 1,
  "page_size": 20,
  "popular": {
    "request": {
      "url": "{base}/manga{?/page/{page}?}?filter=1&order=numc&chapters=1"
    },
    "rows": "#book_list > div.item[data-id]",
    "card": {
      "id": [
        {
          "css": "h3.title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)$"
        }
      ],
      "title": "h3.title a",
      "chapters": "h3.title a",
      "cover": [
        {
          "css": ".wrap_img img"
        },
        {
          "attr": "lazy-src|data-src|src"
        }
      ]
    },
    "next": "a.next.page-numbers"
  },
  "latest": {
    "request": {
      "url": "{base}/latest{?/page/{page}?}"
    },
    "rows": "#book_list > div.item[data-id]",
    "card": {
      "id": [
        {
          "css": "h3.title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)$"
        }
      ],
      "title": "h3.title a",
      "chapters": "h3.title a",
      "cover": [
        {
          "css": ".wrap_img img"
        },
        {
          "attr": "lazy-src|data-src|src"
        }
      ]
    },
    "next": "a.next.page-numbers"
  },
  "search": {
    "request": {
      "url": "{base}/{?page/{page}?}{?&search={term}?}{?&search_by={search_by}?}{?&filter=1&include={genre}?}"
    },
    "rows": "#book_list > div.item[data-id]",
    "card": {
      "id": [
        {
          "css": "h3.title a"
        },
        {
          "attr": "href"
        },
        {
          "regex": "/manga/([^/]+)$"
        }
      ],
      "title": "h3.title a",
      "chapters": "h3.title a",
      "cover": [
        {
          "css": ".wrap_img img"
        },
        {
          "attr": "lazy-src|data-src|src"
        }
      ]
    },
    "next": "a.next.page-numbers"
  },
  "filters": [
    {
      "id": "search_by",
      "name": "Search by",
      "kind": "select",
      "default": "m_name",
      "options": [
        {
          "value": "m_name",
          "name": "Manga name"
        },
        {
          "value": "author",
