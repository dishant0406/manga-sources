{
  "schema": 1,
  "id": "asurascans",
  "name": "Asura Scans",
  "version": 6,
  "lang": [
    "en"
  ],
  "nsfw": false,
  "min_app": "0.1.30",
  "base_url": "https://api.asurascans.com",
  "rate_per_second": 2,
  "auth": {
    "fields": [
      {
        "id": "email",
        "name": "Email"
      },
      {
        "id": "password",
        "name": "Password",
        "secret": true
      }
    ],
    "login": {
      "request": {
        "method": "POST",
        "url": "{base}/api/auth/login",
        "json": {
          "email": "{email}",
          "password": "{password}"
        }
      },
      "format": "json",
      "vars": {
        "access": [
          {
            "coalesce": [
              "data.access_token",
              "access_token"
            ]
          }
        ],
        "refresh": [
          {
            "coalesce": [
              "data.refresh_token",
              "refresh_token"
            ]
          }
        ],
        "user": [
          {
            "coalesce": [
              "data.user.username",
              "user.username"
            ]
          }
        ]
      }
    },
    "refresh": {
      "request": {
        "method": "POST",
        "url": "{base}/api/auth/refresh",
        "json": {
          "refresh_token": "{refresh}"
        }
      },
      "format": "json",
      "vars": {
        "access": [
          {
            "coalesce": [
              "data.access_token",
              "access_token"
            ]
          }
        ],
        "refresh": [
          {
            "coalesce": [
              "data.refresh_token",
              "refresh_token"
            ]
          }
        ]
      }
    },
    "logout": {
      "method": "POST",
      "url": "{base}/api/auth/logout",
      "json": {
        "refresh_token": "{refresh}"
      }
    },
    "headers": {
      "authorization": "Bearer {access}"
    }
  },
  "popular": {
    "request": {
      "url": "{base}/api/series?limit=20&offset={offset}&sort=popular"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "latest": {
    "request": {
      "url": "{base}/api/series?limit=20&offset={offset}&sort=latest"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "search": {
    "request": {
      "url": "{base}/api/series?limit=20&offset={offset}&sort={sort}&order={order}{?&search={term}?}{?&genres={genre}?}{?&type={type}?}{?&status={status}?}{?&author={author}?}{?&artist={artist}?}{?&min_chapters={min_chapters}?}"
    },
    "format": "json",
    "rows": "data",
    "card": {
      "id": "slug",
      "title": "title",
      "cover": "cover",
      "chapters": "chapter_count"
    },
    "next": "meta.has_more"
  },
  "filters": [
    {
      "id": "genre",
      "name": "Genre",
      "kind": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "name": "All"
        },
        {
          "value": "action",
          "name": "Action"
        },
        {
          "value": "adventure",
          "name": "Adventure"
        },
        {
          "value": "comedy",
          "name": "Comedy"
        },
        {
          "value": "crazy-mc",
          "name": "Crazy MC"
        },
        {
          "value": "dark-fantasy",
          "name": "Dark Fantasy"
        },
        {
          "value": "demon",
          "name": "Demon"
        },
        {
          "value": "drama",
          "name": "Drama"
        },
        {
          "value": "dungeons",
          "name": "Dungeons"
        },
        {
          "value": "fantasy",
          "name": "Fantasy"
        },
        {
          "value": "game",
          "name": "Game"
        },
        {
          "value": "genius-mc",
          "name": "Genius MC"
        },
        {
          "value": "isekai",
          "name": "Isekai"
        },
        {
          "value": "magic",
          "name": "Magic"
        },
        {
          "value": "martial-arts",
          "name": "Martial Arts"
        },
        {
          "value": "murim",
          "name": "Murim"
        },
        {
          "value": "mystery",
          "name": "Mystery"
        },
