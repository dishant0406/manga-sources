          "value": "hiatus",
          "name": "Hiatus"
        },
        {
          "value": "dropped",
          "name": "Dropped"
        },
        {
          "value": "axed",
          "name": "Axed"
        }
      ]
    },
    {
      "id": "sort",
      "name": "Sort by",
      "kind": "select",
      "default": "latest",
      "options": [
        {
          "value": "latest",
          "name": "Latest update"
        },
        {
          "value": "popular",
          "name": "Popular"
        },
        {
          "value": "rating",
          "name": "Rating"
        },
        {
          "value": "title",
          "name": "A to Z"
        },
        {
          "value": "newest",
          "name": "Newest"
        }
      ]
    },
    {
      "id": "order",
      "name": "Order",
      "kind": "select",
      "default": "desc",
      "options": [
        {
          "value": "desc",
          "name": "Descending"
        },
        {
          "value": "asc",
          "name": "Ascending"
        }
      ]
    },
    {
      "id": "author",
      "name": "Author",
      "kind": "text"
    },
    {
      "id": "artist",
      "name": "Artist",
      "kind": "text"
    },
    {
      "id": "min_chapters",
      "name": "At least this many chapters",
      "kind": "text"
    }
  ],
  "detail": {
    "request": {
      "url": "{base}/api/series/{id}"
    },
    "format": "json",
    "title": "series.title",
    "cover": "series.cover",
    "description": [
      {
        "path": "series"
      },
      {
        "template": "{?{^.series.description}?}{?<p>Also known as: {^.series.alternative_titles}</p>?}"
      },
      "plain_text"
    ],
    "authors": [
      {
        "path": "series"
      },
      {
        "template": "{?{^.series.author}?}{?/{^.series.artist}?}"
      },
      {
        "split": "/"
      },
      "unique"
    ],
    "tags": "series.genres.*.name",
    "status": [
      {
        "path": "series.status"
      },
      {
        "map": [
          [
            "completed",
            "completed"
          ],
          [
            "ongoing",
            "ongoing"
          ],
          [
            "hiatus",
            "hiatus"
          ],
          [
            "dropped",
            "cancelled"
          ],
          [
            "axed",
            "cancelled"
          ]
        ]
      },
      {
        "default": "unknown"
      }
    ]
  },
  "chapters": {
    "request": {
      "url": "{base}/api/series/{id}/chapters"
    },
    "format": "json",
    "rows": "data",
    "chapter": {
      "id": "slug",
      "number": "number",
      "title": [
        {
          "template": "Chapter {^.number}{? · {^.title}?}"
        },
        {
          "replace": {
            "from": "^(Chapter [0-9.]+) · Chapter [0-9.]+$",
            "to": "$1"
          }
        }
      ],
      "date": [
        {
          "path": "published_at"
        },
        {
          "date": [
            "iso"
          ]
        }
      ],
      "locked": [
        {
          "coalesce": [
            [
              {
                "where": {
                  "path": "is_premium",
                  "equals": "true"
                }
              },
              {
                "path": "slug"
              }
            ],
            [
              {
                "path": "early_access_until"
              },
              {
                "date": [
                  "iso"
                ]
              },
              "in_future"
            ]
          ]
        }
      ]
    },
    "order": "newest-first",
    "locked_label": "Early access"
  },
  "pages": {
    "request": {
      "url": "{base}/api/series/{series}/chapters/{id}"
    },
    "format": "json",
    "images": "data.chapter.pages.*.url",
    "reading": "longstrip",
    "image_headers": {
      "referer": "https://asurascans.com/"
    }
  },
  "page_size": 20
}
