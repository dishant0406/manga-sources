        },
        {
          "value": "manhwa",
          "name": "Manhwa"
        },
        {
          "value": "manhua",
          "name": "Manhua"
        },
        {
          "value": "manga",
          "name": "Mangatoon"
        }
      ]
    },
    {
      "id": "status",
      "name": "Status",
      "kind": "select",
      "default": "",
      "options": [
        {
          "value": "",
