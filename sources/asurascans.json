        },
        {
          "value": "psychological",
          "name": "Psychological"
        },
        {
          "value": "regression",
          "name": "Regression"
        },
        {
          "value": "reincarnation",
          "name": "Reincarnation"
        },
        {
          "value": "revenge",
          "name": "Revenge"
        },
        {
          "value": "romance",
          "name": "Romance"
        },
        {
          "value": "school-life",
          "name": "School Life"
        },
        {
          "value": "sci-fi",
          "name": "Sci-fi"
        },
        {
          "value": "shoujo",
